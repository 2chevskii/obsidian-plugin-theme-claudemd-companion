{
  "name": "claude-theme-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Motion and interaction refinements for the Claude.md Obsidian theme.",
  "main": "main.js",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "jsdom": "^30.1.0",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
